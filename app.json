{
  "expo": {
    "name": "Llanero",
    "slug": "llanero-app",
    "owner": "llanerobodegon",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "llaneroapp",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0895c24a-debd-4ff9-a48a-4642c77f8e8f"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.llanerobodegon.llaneroapp",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "Llanero"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "39"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.llanerobodegon.llanero",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 6
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#790102",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Llanero usa tus fotos para adjuntar el comprobante de tu pago.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0895c24a-debd-4ff9-a48a-4642c77f8e8f"
      }
    }
  }
}
